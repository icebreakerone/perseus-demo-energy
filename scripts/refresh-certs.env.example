# Configuration for scripts/refresh-certs.sh
#
# Copy this file to scripts/refresh-certs.env and fill in the blanks. That file
# is gitignored. Exported environment variables take precedence over it, and
# command line options take precedence over both.

# --- Directory service (sandbox trust framework) ---------------------------

DIRECTORY_API_URL=https://directory.core.sandbox.trust.ib1.org
DIRECTORY_COGNITO_DOMAIN=https://auth.member.core.sandbox.trust.ib1.org

# The public CLI app client id for this environment. It is the
# CliCognitoClientId output of the directory API stack:
#   aws cloudformation describe-stacks --stack-name PerseusDirectoryApiStack-sandbox \
#     --query "Stacks[0].Outputs[?OutputKey=='CliCognitoClientId'].OutputValue" \
#     --output text
DIRECTORY_COGNITO_CLIENT_ID=19q088buq836rq46b53v6kpj7h

# --- Applications ----------------------------------------------------------
#
# Each part of the stack is a different Perseus scheme participant, so its
# certificates are issued to a different application:
#
#   cap-demo      a carbon accounting provider. Needs a client certificate for
#                 mTLS and a signing certificate for its provenance record.
#   resource API  an energy data provider. Needs a signing certificate.
#
# Run ./scripts/refresh-certs.sh --list-apps to see your organisations and
# their applications. The organisation is looked up automatically when only the
# application is given, and the EDP application is looked up from its role when
# only the organisation is given.

# Carbon Accounting Provider (sandbox)
CAP_ORGANIZATION=4tnapijm
CAP_APP_ID=jh7ujmiy

# Energy Data Provider (sandbox)
EDP_ORGANIZATION=7a1qv915
# Perseus Demo Energy Resource, matching resource/cdk/scripts/upload-certificates.sh
EDP_APP_ID=v60qlnnh

# --- Behaviour -------------------------------------------------------------

# Revoke the certificates issued by the previous run. Off by default: these
# applications are shared with the deployed environments, so a certificate this
# script replaces locally may still be in use elsewhere.
REVOKE_PREVIOUS=false
